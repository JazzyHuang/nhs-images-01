      }

      .cls-1, .cls-3, .cls-5, .cls-9, .cls-6, .cls-10, .cls-7, .cls-8 {
        stroke-width: .5px;
      }

      .cls-1, .cls-3, .cls-5, .cls-8 {
        stroke: #888;
      }

      .cls-1, .cls-8 {
        stroke-linecap: round;
      }

      .cls-2 {
        opacity: 0;
      }

      .cls-2, .cls-4, .cls-5, .cls-10, .cls-7 {
        stroke-miterlimit: 10;
      }

      .cls-2, .cls-4, .cls-9, .cls-6, .cls-10, .cls-7 {
