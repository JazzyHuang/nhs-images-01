  <defs>
    <style>
      .cls-1 {
        opacity: 0;
      }

      .cls-1, .cls-2, .cls-3, .cls-4, .cls-5, .cls-6, .cls-7, .cls-8 {
        fill: none;
      }

      .cls-1, .cls-2, .cls-9, .cls-6 {
        stroke: #000;
      }

      .cls-1, .cls-9, .cls-4 {
        stroke-miterlimit: 10;
      }

      .cls-2, .cls-3, .cls-9, .cls-4, .cls-7, .cls-8 {
        stroke-width: .5px;
      }

      .cls-2, .cls-5, .cls-6 {
        stroke-miterlimit: 500;
      }

      .cls-10 {
        font-family: MabryPro-Medium, 'Mabry Pro';
        font-size: 14px;
        font-weight: 500;
      }

      .cls-3, .cls-4, .cls-7, .cls-8 {
        stroke: #888;
      }

      .cls-9 {
        fill: #fff;
      }

      .cls-5 {
        stroke: #d5d5d5;
      }

      .cls-5, .cls-6 {
        stroke-width: 1.5px;
      }

      .cls-7 {
        stroke-linejoin: round;
      }

      .cls-7, .cls-8 {
        stroke-linecap: round;
      }
    </style>
  </defs>
